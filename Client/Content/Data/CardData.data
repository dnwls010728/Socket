cards:
  100000:
    name: "광역 공격 스킬"
    desc: "넓은 범위에 참격을 날리는 스킬을 획득합니다."
    icon:
      path: "UI\\SkillIconSet.png"
      index: 5
    skill_id: 100005
  100001:
    name: "빠른 공격 스킬"
