      path: "UI\\SkillIconSet.png"
      index: 5
    skill_id: 100005
  100006:
    name: "베어 슬레쉬"
    desc: "곰을 소환하여 정면 범위에 공격을 가하는 스킬을 획득합니다."
    icon:
      path: "UI\\SkillIconSet.png"
      index: 6
    skill_id: 100006
  100101:
    name: "체력 카드(소)"
