cards:
  100001:
    name: "다크 임페일"
    desc: "정면에 참격을 날리는 스킬을 획득합니다."
    icon:
      path: "UI\\SkillIconSet.png"
      index: 1
    skill_id: 100001
  100002:
    name: "팬텀 블로우"
    desc: "캐릭터 정면의 적을 찔러 공격하는 스킬을 획득합니다."
    icon:
      path: "UI\\SkillIconSet.png"
      index: 2
    skill_id: 100002
  100003:
    name: "스매시"
    desc: "캐릭터 주변에 무기를 휘두르는 스킬을 획득합니다."
    icon:
      path: "UI\\SkillIconSet.png"
      index: 3
    skill_id: 100003
  100004:
    name: "체인 스트로크"
    desc: "채찍으로 정면 범위를 휩쓰는 스킬을 획득합니다."
