target: Sprites\Character\Player\PlayerSheet.png
animations:
  - name: Idle
    frame_rate: 8
    loop: true
    frames:
      - PlayerSheet_0
      - PlayerSheet_1
  - name: Walk
    frame_rate: 8
    loop: true
    frames:
      - PlayerSheet_16
      - PlayerSheet_17
      - PlayerSheet_18
      - PlayerSheet_19
  - name: Run
    frame_rate: 8
    loop: true
    frames:
      - PlayerSheet_24
      - PlayerSheet_25
      - PlayerSheet_26
      - PlayerSheet_27
      - PlayerSheet_28
      - PlayerSheet_29
      - PlayerSheet_30
      - PlayerSheet_31